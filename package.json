{
  "name": "gk80-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ui:fixtures": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "contract:generate": "node scripts/contract-generation.mjs --write",
    "contract:check": "node scripts/contract-generation.mjs",
    "contract:test": "node --test scripts/verify-contract-generation.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "build": "npm run typecheck && vite build",
    "build:desktop": "npm run typecheck && vite build --mode desktop --outDir dist-desktop",
    "build:browser": "npm run typecheck && vite build --mode browser --outDir bin/browser-assets --emptyOutDir",
    "iab:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-iab.ps1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:host": "node scripts/check-host.mjs",
    "check:host:native": "node scripts/check-host.mjs --native",
    "check:host:runner": "node --test scripts/verify-host-checks.mjs",
    "check:quick": "npm run typecheck && npm run lint && npm test",
    "check:pr": "npm run check:quick && npm run build && npm run test:e2e",
    "check:go": "node scripts/check-go.mjs",
    "check:portable": "npm run check:pr && npm run check:go && npm run check:host && npm run check:host:runner",
    "check:full": "npm run check:windows && npm run check:portable",
    "check:windows": "npm run check:host:native && node scripts/check-go.mjs --native && npm run contract:check && npm run contract:test",
    "check:race": "node scripts/check-go.mjs --race",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:fuzz": "node scripts/check-fuzz.mjs",
    "check:deps": "node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.69.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "uplot": "1.6.32",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
