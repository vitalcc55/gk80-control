{
  "name": "gk80-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ui:fixtures": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "contract:generate": "node scripts/contract-generation.mjs --write",
    "contract:check": "node scripts/contract-generation.mjs",
    "contract:test": "node --test scripts/verify-contract-generation.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "build": "npm run typecheck && vite build",
    "build:desktop": "npm run typecheck && vite build --mode desktop --outDir dist-desktop",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:quick": "npm run typecheck && npm run lint && npm test",
    "check:pr": "npm run check:quick && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "uplot": "1.6.32",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
